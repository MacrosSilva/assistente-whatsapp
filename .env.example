# Copie para .env e preencha. O .env nunca vai pro git.
# Seu número PRINCIPAL (quem recebe e quem pode mandar comandos), formato: DDI+DDD+número, só dígitos
MEU_NUMERO=5571999999999

# Portas locais (só 127.0.0.1)
CORE_PORT=8765
BRIDGE_PORT=8766

# Segredo compartilhado entre Python e Node (gerado automaticamente no passo 2)
BRIDGE_TOKEN=
